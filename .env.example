# MAHA LAKSHMI CORP - Environment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-here

# Gumroad Integration
GUMROAD_API_KEY=

# Webhook Security
WEBHOOK_SECRET=

# SMTP Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Database
DATABASE_URL=sqlite:///./data/maha_lakshmi.db

# CORS
CORS_ORIGINS=https://mahalaksmi.web.id,https://www.mahalaksmi.web.id,http://localhost:3000,http://localhost:8000

# Redis (optional)
REDIS_URL=

# Logging
LOG_LEVEL=INFO
