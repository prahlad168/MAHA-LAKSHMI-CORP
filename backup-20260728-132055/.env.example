# MAHA SALES ENGINE V1 - Environment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Gumroad API Configuration
GUMROAD_API_KEY=

# Database Configuration
DATABASE_PATH=./db/maha_sales_engine.db

# Security
API_KEY=
ENCRYPTION_KEY=

# Logging
LOG_LEVEL=INFO

# Marketplace Connector
MARKETPLACE_DB_URL=sqlite:///./db/marketplace_connector.db
WEBHOOK_SECRET=
