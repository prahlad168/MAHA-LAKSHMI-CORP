# MAHA LAKSHMI CORP - Production Environment Configuration
# This file should be set as environment variables on your production server

# JWT Authentication - CHANGE THIS TO A RANDOM SECRET KEY!
JWT_SECRET_KEY=your-production-secret-key-here-change-this

# Gumroad Integration
GUMROAD_API_KEY=

# Webhook Security
WEBHOOK_SECRET=

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=MAHA LAKSHMI CORP &lt;noreply@mahalaksmi.web.id&gt;

# Database - Use PostgreSQL in production
DATABASE_URL=postgresql://user:password@localhost/maha_lakshmi

# CORS - Production domains only
CORS_ORIGINS=https://mahalaksmi.web.id,https://www.mahalaksmi.web.id

# Redis (recommended for production)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=WARNING
