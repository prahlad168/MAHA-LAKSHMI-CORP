# MAHA Sales Engine V1 - Production Configuration

# Environment
MAHA_ENV=production
NODE_ID=node-1

# Database
DATABASE_URL=postgresql://maha:maha123@postgres:5432/maha_sales
DATABASE_PATH=data/maha.db
DB_POOL_SIZE=10
DB_TIMEOUT=30

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50

# Security
MAHA_SECRET_KEY=change-me-in-production-use-strong-secret
MAHA_ENCRYPTION_KEY=change-me-in-production-use-32-char-key
JWT_ALGORITHM=HS256
JWT_EXPIRY=3600

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_TIMEOUT=30
API_CORS_ORIGINS=*

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin
METRICS_RETENTION_DAYS=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=20
LOG_FILE_PATH=/app/logs/maha-engine.log

# Health Check
HEALTH_CHECK_PORT=8000
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# WhatsApp
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_MAX_PER_DAY=20

# LinkedIn
LINKEDIN_API_URL=
LINKEDIN_TOKEN=
LINKEDIN_MAX_PER_DAY=15

# Marketplaces
GUMROAD_API_KEY=
SHOPIFY_API_KEY=
SHOPIFY_STORE_URL=
ETSY_API_KEY=

# AI
AI_ENABLED=true
AI_MODEL=gpt-4
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000

# Feature Flags
ENABLE_METRICS=true
ENABLE_AUDIT=true
ENABLE_MISSION_CONTROL=true
ENABLE_SALES_AUTOMATION=true
ENABLE_PRODUCT_FACTORY=true

# Deployment
DOCKER_REGISTRY=ghcr.io
IMAGE_TAG=latest
DEPLOYMENT_ENV=production
