# Environment Configuration Template
# Copy this file to .env and fill in the values

# Environment
MAHA_ENV=production
NODE_ID=node-1

# Database
DATABASE_URL=sqlite:///data/maha.db
DATABASE_PATH=data/maha.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
MAHA_SECRET_KEY=your-secret-key-here
MAHA_ENCRYPTION_KEY=your-encryption-key-here

# API Keys
GUMROAD_API_KEY=
SHOPIFY_API_KEY=
SHOPIFY_STORE_URL=
ETSY_API_KEY=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# WhatsApp
WHATSAPP_API_URL=
WHATSAPP_TOKEN=

# LinkedIn
LINKEDIN_API_URL=
LINKEDIN_TOKEN=

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PASSWORD=admin

# Deployment
DOCKER_REGISTRY=ghcr.io
IMAGE_TAG=latest

# Health Check
HEALTH_CHECK_PORT=8000
HEALTH_CHECK_INTERVAL=30

# Logging
LOG_LEVEL=INFO
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=10

# Feature Flags
ENABLE_METRICS=true
ENABLE_AUDIT=true
ENABLE_MISSION_CONTROL=true
